---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name="统计" id="busuanzi-stats" class:list={[className]} {style}>
	<div class="text-center py-2">
		<div
			class="text-3xl font-bold text-neutral-900 dark:text-neutral-100"
			id="busuanzi_value_site_pv"
		>
			-
		</div>
		<div class="text-sm text-neutral-500 dark:text-neutral-400">总浏览量</div>
	</div>
	<div class="grid grid-cols-2 divide-x divide-neutral-200 dark:divide-neutral-700 text-center pt-2">
		<div class="px-2">
			<div
				class="text-xl font-bold text-neutral-900 dark:text-neutral-100"
				id="busuanzi_value_site_uv"
			>
				-
			</div>
			<div class="text-sm text-neutral-500 dark:text-neutral-400">访客数</div>
		</div>
		<div class="px-2">
			<div
				class="text-xl font-bold text-neutral-900 dark:text-neutral-100"
				id="busuanzi_value_page_pv"
			>
				-
			</div>
			<div class="text-sm text-neutral-500 dark:text-neutral-400">本页浏览量</div>
		</div>
	</div>
</WidgetLayout>

<script is:inline>
(function () {
	const BUSUANZI_SCRIPT_ID = "busuanzi-script";
	const BUSUANZI_ENDPOINT = "https://busuanzi.ibruce.info/busuanzi";
	const VALUE_IDS = [
		"busuanzi_value_site_pv",
		"busuanzi_value_site_uv",
		"busuanzi_value_page_pv",
	];
	let activeCallbackName = "";

	function resetStats() {
		VALUE_IDS.forEach((id) => {
			const element = document.getElementById(id);
			if (element) element.textContent = "-";
		});
	}

	function loadBusuanzi() {
		const oldScript = document.getElementById(BUSUANZI_SCRIPT_ID);
		if (oldScript) oldScript.remove();
		if (activeCallbackName) delete window[activeCallbackName];

		resetStats();
		const callbackName = `BusuanziCallback_${Date.now()}_${Math.floor(
			Math.random() * 1000000,
		)}`;
		activeCallbackName = callbackName;
		window[callbackName] = function (data) {
			const values = {
				busuanzi_value_site_pv: data.site_pv,
				busuanzi_value_site_uv: data.site_uv,
				busuanzi_value_page_pv: data.page_pv,
			};

			Object.entries(values).forEach(([id, value]) => {
				const element = document.getElementById(id);
				if (element) element.textContent = value ?? "-";
			});

			const script = document.getElementById(BUSUANZI_SCRIPT_ID);
			if (script) script.remove();
			delete window[callbackName];
			if (activeCallbackName === callbackName) activeCallbackName = "";
		};

		const script = document.createElement("script");
		script.id = BUSUANZI_SCRIPT_ID;
		script.async = true;
		script.referrerPolicy = "no-referrer-when-downgrade";
		script.onerror = function () {
			delete window[callbackName];
			if (activeCallbackName === callbackName) activeCallbackName = "";
		};
		script.src = `${BUSUANZI_ENDPOINT}?jsonpCallback=${callbackName}&_=${Date.now()}`;
		document.body.appendChild(script);
	}

	function setupSwupRefresh() {
		if (!window.swup || window.__busuanziSwupRefreshBound) return;

		window.__busuanziSwupRefreshBound = true;
		window.swup.hooks.on("page:view", loadBusuanzi);
	}

	loadBusuanzi();
	setupSwupRefresh();
	document.addEventListener("swup:enable", setupSwupRefresh, { once: true });
})();
</script>
